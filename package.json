{
  "name": "nestjs-boilerplate",
  "version": "0.0.1",
  "description": "NestJS Boilerplate, Typescript, Postgres, TypeORM",
  "author": "vndevteam",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build platform",
    "format": "prettier --write \"apps/**/src/**/*.ts\" \"apps/**/test/**/*.ts\"",
    "start": "nest start platform",
    "start:dev": "nest start platform --watch",
    "start:debug": "nest start platform --debug --watch",
    "start:prod": "node dist/apps/platform/apps/platform/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "build:platform": "nest build platform",
    "test:platform": "jest --config apps/platform/jest.config.json",
    "test": "jest --config apps/platform/jest.config.json",
    "test:watch": "jest --config apps/platform/jest.config.json --watch",
    "test:cov": "jest --config apps/platform/jest.config.json --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config apps/platform/test/jest-e2e.json",
    "typeorm": "env-cmd typeorm-ts-node-commonjs -d apps/platform/src/database/data-source.ts",
    "migration:up": "pnpm typeorm migration:run",
    "migration:down": "pnpm typeorm migration:revert",
    "migration:show": "pnpm typeorm migration:show",
    "migration:create": "typeorm migration:create",
    "migration:generate": "pnpm typeorm migration:generate --pretty",
    "db:create": "env-cmd ts-node ./node_modules/typeorm-extension/bin/cli.cjs db:create -d apps/platform/src/database/data-source.ts",
    "db:drop": "env-cmd ts-node ./node_modules/typeorm-extension/bin/cli.cjs db:drop -d apps/platform/src/database/data-source.ts",
    "seed:run": "env-cmd ts-node ./node_modules/typeorm-extension/bin/cli.cjs seed:run -d apps/platform/src/database/data-source.ts",
    "seed:create": "env-cmd ts-node ./node_modules/typeorm-extension/bin/cli.cjs seed:create -d apps/platform/src/database/data-source.ts",
    "prepare": "husky || true",
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs",
    "start:dev:catalog": "nest start catalog --watch",
    "build:catalog": "nest build catalog",
    "test:catalog": "jest apps/catalog/src",
    "start:dev:finance": "nest start finance --watch",
    "build:finance": "nest build finance",
    "test:finance": "jest apps/finance/src",
    "start:dev:integration": "nest start integration --watch",
    "build:integration": "nest build integration",
    "test:integration": "jest apps/integration/src",
    "start:dev:insight": "nest start insight --watch",
    "build:insight": "nest build insight",
    "test:insight": "jest apps/insight/src",
    "start:dev:inventory": "nest start inventory --watch",
    "build:inventory": "nest build inventory",
    "test:inventory": "jest apps/inventory/src",
    "start:dev:sales": "nest start sales --watch",
    "build:sales": "nest build sales",
    "test:sales": "jest apps/sales/src",
    "start:dev:customer": "nest start customer --watch",
    "build:customer": "nest build customer",
    "test:customer": "jest apps/customer/src",
    "build:libs": "node scripts/build-libs.mjs",
    "pack:libs": "pnpm build:libs && pnpm --dir libs/common pack --pack-destination ../../dist/packs && pnpm --dir libs/auth pack --pack-destination ../../dist/packs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:libs": "jest libs",
    "test:arch": "jest libs/common/src/bootstrap/ddd-architecture-fitness.spec.ts apps/platform/src/platform-architecture.spec.ts apps/catalog/src/catalog-architecture.spec.ts apps/inventory/src/inventory-architecture.spec.ts apps/sales/src/sales-architecture.spec.ts apps/customer/src/customer-architecture.spec.ts apps/finance/src/finance-architecture.spec.ts apps/integration/src/integration-architecture.spec.ts apps/insight/src/insight-architecture.spec.ts",
    "test:int": "jest --config libs/events/test/jest-int.json",
    "verify:m8": "node scripts/m8-verify-system.mjs",
    "redrive:dlq": "node scripts/redrive-dlq.js"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1129.0",
    "@aws-sdk/client-sqs": "^3.1129.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^2.3.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "argon2": "^0.41.1",
    "axios": "^1.7.7",
    "cache-manager": "^5.7.6",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "helmet": "^8.0.0",
    "ioredis": "5.4.1",
    "jwks-rsa": "^3.2.2",
    "ms": "^2.1.3",
    "nestjs-i18n": "^10.5.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.13.1",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.20",
    "typeorm-extension": "^3.6.3",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.14.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@swc/cli": "^0.5.0",
    "@swc/core": "^1.7.42",
    "@types/compression": "^1.7.5",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/ms": "^0.7.34",
    "@types/node": "^22.8.7",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vuepress/bundler-vite": "2.0.0-rc.17",
    "@vuepress/plugin-markdown-image": "2.0.0-rc.52",
    "@vuepress/plugin-markdown-tab": "2.0.0-rc.52",
    "@vuepress/plugin-search": "2.0.0-rc.52",
    "@vuepress/theme-default": "2.0.0-rc.52",
    "env-cmd": "^10.1.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "sass-embedded": "^1.80.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vue": "^3.5.12",
    "vuepress": "2.0.0-rc.17",
    "vuepress-plugin-md-enhance": "2.0.0-rc.59"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@pbl/auth(|/.*)$": "<rootDir>/libs/auth/src$1",
      "^@pbl/common(|/.*)$": "<rootDir>/libs/common/src$1",
      "^@pbl/contracts(|/.*)$": "<rootDir>/libs/contracts/src$1",
      "^@pbl/events(|/.*)$": "<rootDir>/libs/events/src$1"
    }
  }
}
